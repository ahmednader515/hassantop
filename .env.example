# Copy to local .env and fill values. On Hostinger VPS, also set NEXTAUTH_URL.

# Neon (or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth — REQUIRED in production (public HTTPS URL of this app)
NEXTAUTH_URL="https://YOUR_DOMAIN"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Optional: extra Server Action hosts (comma-separated)
# ALLOWED_ORIGINS="www.YOUR_DOMAIN"

# Multi-tenant root domain (optional)
# NEXT_PUBLIC_ROOT_DOMAIN="YOUR_DOMAIN"

UPLOADTHING_TOKEN=""
UPLOADTHING_SECRET=""

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""

PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
